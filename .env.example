# ── Provider selection ────────────────────────────────────────────────────────
# Choose: openai | gemini
LLM_PROVIDER=openai

# ── OpenAI (if LLM_PROVIDER=openai) ──────────────────────────────────────────
OPENAI_API_KEY=your-openai-key-here

# ── Gemini (if LLM_PROVIDER=gemini) ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-key-here

# ── Email (SMTP via Gmail) ─────────────────────────────────────────────────────
# Get an App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_FROM_EMAIL=your-gmail@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Optional: override default models ─────────────────────────────────────────
# OpenAI defaults:  CHAT_MODEL=gpt-4o          EMBED_MODEL=text-embedding-3-small
# Gemini defaults:  CHAT_MODEL=gemini-2.0-flash EMBED_MODEL=models/text-embedding-004
# CHAT_MODEL=
# EMBED_MODEL=
